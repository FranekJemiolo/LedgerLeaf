#!/usr/bin/env sh

# Run type checking first
echo "🔍 Running TypeScript type check..."
npm run type-check
if [ $? -ne 0 ]; then
    echo "❌ TypeScript errors found. Please fix before committing."
    exit 1
fi

# Run linting
echo "🔍 Running linter..."
npm run lint
if [ $? -ne 0 ]; then
    echo "❌ Linting errors found. Please fix before committing."
    exit 1
fi

# Run unit tests
echo "🧪 Running unit tests..."
npm test --if-present 2>/dev/null || true
if [ $? -ne 0 ]; then
    echo "❌ Unit tests failed. Please fix before committing."
    exit 1
fi

# Run build
echo "🏗 Running build..."
npm run build
if [ $? -ne 0 ]; then
    echo "❌ Build failed. Please fix before committing."
    exit 1
fi

echo "✅ All pre-commit checks passed!"
